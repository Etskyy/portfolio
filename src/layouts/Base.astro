---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio and blog.' } = Astro.props;
const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} · loxton.dev</title>
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <a href="/" style="text-decoration: none;">
          <span class="sidebar__id">loxton.dev</span>
        </a>
        <span class="sidebar__role">Developer &amp; creator</span>
        <nav>
          <a href="/" aria-current={isActive('/') ? 'page' : undefined}>~/home</a>
          <a href="/projects" aria-current={isActive('/projects') ? 'page' : undefined}>~/projects</a>
          <a href="/blog" aria-current={isActive('/blog') ? 'page' : undefined}>~/blog</a>
          <a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>~/about</a>
        </nav>
      </aside>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
